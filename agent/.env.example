# matsya AI Agent — Environment Variables
# Copy to .env and fill in real values

# AWS
AWS_REGION=ap-south-1
BEDROCK_REGION=ap-south-1
BEDROCK_MODEL_ID=arn:aws:bedrock:ap-south-1:604010685667:inference-profile/global.anthropic.claude-sonnet-4-6

# DynamoDB tables
DYNAMODB_CONVERSATIONS_TABLE=ai-bharat-conversations
DYNAMODB_MESSAGES_TABLE=ai-bharat-messages
DYNAMODB_MEMORY_TABLE=ai-bharat-memory
DYNAMODB_IMAGES_TABLE=ai-bharat-images
DYNAMODB_CHATS_TABLE=ai-bharat-chats
DYNAMODB_USERS_TABLE=ai-bharat-users

# Cognito
COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
COGNITO_CLIENT_ID=

# External APIs
OPENWEATHERMAP_API_KEY=
TAVILY_API_KEY=

FISH_WEIGHT_API_URL=
# Memory
SHORT_TERM_MESSAGE_LIMIT=10
CATCH_HISTORY_PAGE_SIZE=10

# Demo
DEMO_MODE=true

# LLM backend selection
# true  = use Google Gemini (default)
# false = use AWS Bedrock (Nova Pro)
USE_GEMINI=true

# Google Gemini
GOOGLE_API_KEY=
GEMINI_MODEL=models/gemini-2.5-flash
