{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicReadGetObject",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::fish-detection-project-2026/rag/*"
    },
    {
      "Sid": "PublicListBucket",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::fish-detection-project-2026",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "rag/*"
          ]
        }
      }
    }
  ]
}
